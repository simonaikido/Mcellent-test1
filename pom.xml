           CVE-2025-8916, CVE-2026-5588 (all reported against bcprov/bcpkix-jdk15on@1.68).
           spring-cloud-starter:3.1.3 hard-codes 1.0.10.RELEASE; this pin overrides it. -->
      <dependency>
        <groupId>org.springframework.security</groupId>
        <artifactId>spring-security-rsa</artifactId>
        <version>1.0.13.RELEASE</version>
      </dependency>

      <!-- Belt-and-suspenders: pin jdk15on to the highest published release (1.70 / 1.7)
           so that if any other transitive path still resolves them, Trivy sees a patched version.
           bcprov-jdk15on max published = 1.70 (fixes CVE-2023-33202 @ 1.70).
           bcpkix-jdk15on max published = 1.7 (alias for 1.70). -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk15on</artifactId>
        <version>1.70</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpkix-jdk15on</artifactId>
        <version>1.70</version>
      </dependency>

